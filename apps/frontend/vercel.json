{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.athlonsport.app.br/api/v1/:path*"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "https://api.athlonsport.app.br/api/cron/:path*"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-|manifest\\.webmanifest|logo\\.png|icon-).*)",
      "destination": "/index.html"
    }
  ]
}
