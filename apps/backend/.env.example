DATABASE_URL=postgresql://user:password@localhost:5432/athonsport
DATABASE_SSL=false
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=athonsport
R2_PUBLIC_BASE_URL=

# Web Push (rode: pnpm generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@athonsport.app.br

# Cron interno
CRON_SECRET=
CRON_ENABLED=true

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=ATHLON <noreply@athonsport.app.br>

# Recuperação de senha em dev
RECOVERY_SHOW_CODE=true

# Admin (seed: pnpm seed:admin)
ADMIN_EMAIL=admin@athonsport.app.br
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NOME=Administrador
