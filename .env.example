# Backend (apps/backend/.env)
DATABASE_URL=postgresql://user:password@localhost:5432/athonsport
DATABASE_SSL=false
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=athonsport
R2_PUBLIC_BASE_URL=

# Web Push (rode: pnpm generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@athonsport.app.br

# Cron interno (node-cron no Railway)
CRON_SECRET=
CRON_ENABLED=true

# E-mail (Resend - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=ATHLON <noreply@athonsport.app.br>

# Admin (seed inicial - rode: pnpm seed:admin)
ADMIN_EMAIL=admin@athonsport.app.br
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NOME=Administrador

# Recuperação de senha em dev (mostra código na tela)
RECOVERY_SHOW_CODE=true

# Frontend (apps/frontend/.env)
# Desenvolvimento local:
VITE_API_URL=http://localhost:3001/api/v1

# Produção (Vercel - Environment Variables):
# VITE_API_URL=https://api.athonsport.app.br/api/v1
# Não defina variáveis de backend na Vercel — apenas no Railway.
