{
  "buildCommand": "VITE_API_URL=/api/v1 pnpm run build:frontend",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.athlonsport.app.br/api/v1/:path*"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "https://api.athlonsport.app.br/api/cron/:path*"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-|manifest\\.webmanifest|logo\\.png|icon-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
